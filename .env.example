DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_SITE_URL=http://localhost:5173

# Set to true only when a reverse proxy that terminates TLS sits in front of the
# app (Azure Container Apps ingress, nginx-proxy, App Gateway). Django then
# reads X-Forwarded-Proto to decide whether a request arrived over HTTPS. A
# client can forge that header, so leaving this false when there is no proxy is
# what keeps it trustworthy.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Database. Leave POSTGRES_HOST unset to use the local SQLite database.
# POSTGRES_HOST=
# POSTGRES_DB=agentic_housing
# POSTGRES_USER=agentic_housing
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# Managed servers such as Azure Flexible Server require TLS; use "require"
# there. The "prefer" default suits a Postgres container on a private network.
# POSTGRES_SSLMODE=prefer

# OpenAI-compatible endpoint. Azure OpenAI v1-compatible endpoints work here.
OPENAI_BASE_URL=https://example.openai.azure.com/openai/v1/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DRAFTING_ENABLED=false
# Draft generation runs on a background thread and the app polls it, because it
# can outlast any proxy timeout (75-161 s observed). A job silent this long is
# reported failed so the advocate can retry.
DRAFT_GENERATION_BACKGROUND=true
# Prepare and export no-AI templates as background jobs.
TEMPLATE_FILL_BACKGROUND=true
DRAFT_GENERATION_TIMEOUT_SECONDS=900

# Research is always constrained to a jurisdiction. This is the organization
# fallback; a Django-admin setting or individual user profile can override it.
DEFAULT_JURISDICTION=Ohio

# Repository content library. Keep the default for local development; a future
# admin-selected SharePoint provider will use the same logical layout.
CONTENT_LIBRARY_DIR=content
ORGANIZATION_CONTENT_LIBRARY_DIR=private-content
# Generated public content read from the document store rather than the image.
PUBLISHED_CONTENT_LIBRARY_DIR=private-content/storage/published/content

# Side-loaded document storage: case-law PDFs and private organization content.
# Every store is split into three areas (see apps.core.storage):
#
#   raw/        what you upload. Source material, nothing serves from here.
#   validated/  generated artifacts that passed checks but are not live.
#   published/  what the app reads and serves, written by an ingest/publish step.
#
# "filesystem" points at a directory or mounted file share; "azure_blob" uses
# native Azure Blob Storage; "s3" targets any
# S3-compatible endpoint (AWS, Cloudflare R2, Backblaze B2, MinIO) and needs
# boto3 installed plus a bucket and keys; switching stores is config, not code.
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_STORAGE_ROOT=private-content/storage
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ENDPOINT_URL=
DOCUMENT_STORAGE_ACCESS_KEY_ID=
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
DOCUMENT_STORAGE_REGION=
# Native Azure Blob backend. Prefer workload identity/account URL in production;
# the connection string is useful for Azurite and tightly controlled deployments.
DOCUMENT_STORAGE_AZURE_CONTAINER=
DOCUMENT_STORAGE_AZURE_CONNECTION_STRING=
DOCUMENT_STORAGE_AZURE_ACCOUNT_URL=
DOCUMENT_STORAGE_AZURE_CREDENTIAL=

# Key prefixes within each area.
CASELAW_STORAGE_PREFIX=caselaw
PRIVATE_CONTENT_STORAGE_PREFIX=private-content
CASELAW_IMPORT_REQUIRE_VERIFIED=false
CASELAW_IMPORT_APPROVE_VERIFIED_FOR_SEARCH=true
CASELAW_IMPORT_APPROVE_UNVERIFIED_FOR_SEARCH=false

# LegalServer instance API settings. Paths are configurable because instances vary.
LEGALSERVER_BASE_URL=https://your-site.legalserver.org
LEGALSERVER_API_TOKEN=
LEGALSERVER_MATTERS_PATH=/api/v2/matters
LEGALSERVER_MATTERS_RESULTS=full
LEGALSERVER_MATTER_DOCUMENTS_PATH=/api/v1/matters/{matter_id}/documents
LEGALSERVER_MATTER_PROFILE_PATH=/matter/dynamic-profile/view/{matter_id}
LEGALSERVER_USER_FILTER_PARAM=assigned_user_email
# Seconds a case's LegalServer document list is reused per server process.
# Every case preview, materials load and fact recommendation reads it, and
# LegalServer rate-limits; 0 fetches every time.
LEGALSERVER_DOCUMENT_CACHE_SECONDS=120

# Saving generated work back to the case file. Documents are opt-out so a draft
# is never lost with the browser tab; research answers and triage assessments
# are opt-in because they are working judgments.
# These follow the published v2 write contracts. Each needs its own role
# permission on the site: "API Create Note", "API Create Document", and the
# Premium "API Matter: Update". All three address a matter by its UUID.
LEGALSERVER_NOTES_PATH=/api/v2/notes
LEGALSERVER_DOCUMENTS_PATH=/api/v2/documents
LEGALSERVER_MATTER_UPDATE_PATH=/api/v2/matters/{case_uuid}
LEGALSERVER_MATTER_UPDATE_METHOD=PATCH
# Optional document-type lookup value applied to uploads, e.g. "Brief". Blank
# leaves the site's own default in place.
LEGALSERVER_DOCUMENT_TYPE=
# Note-type lookup value. The notes endpoint requires one. "Case Notes" is a
# system lookup on a stock site; see /api/v2/lookups/note_type for the values
# your site offers.
LEGALSERVER_CASE_NOTE_TYPE=Case Notes
# Master switch for all writes to LegalServer. Forced off while tests run so a
# test can never upload to a real case file.
LEGALSERVER_ALLOW_WRITES=true
LEGALSERVER_SAVE_DOCUMENTS_DEFAULT=true
LEGALSERVER_SAVE_RESEARCH_DEFAULT=false
LEGALSERVER_SAVE_TRIAGE_DEFAULT=false
# Which file under content/legalserver-field-maps/ maps a triage outcome to case
# properties. Blank turns the mapping off entirely.
LEGALSERVER_TRIAGE_FIELD_MAP=triage-outcome

# Microsoft Graph / SharePoint Online settings.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ACCESS_TOKEN=
SHAREPOINT_CASE_FOLDER_TEMPLATE=Cases/{matter_id}

# Office 365 sign-in and delegated Microsoft Graph access.
# Use a concrete tenant UUID and approve each immutable principal in Django admin.
OFFICE365_TENANT_ID=
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_REDIRECT_URI=http://localhost:5173/api/auth/office365/callback/
OFFICE365_SCOPES=openid profile email offline_access User.Read Sites.Read.All Files.Read.All

# Use Django RemoteUserMiddleware when Office 365 SSO is terminated upstream.
ENABLE_REMOTE_USER_AUTH=false

# Container serving (docker/web.sh). Threads let requests waiting on the model
# or LegalServer free their worker. workers x threads x max replicas must stay
# under the Postgres server's max_connections (3 x 4 x 3 = 36).
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
